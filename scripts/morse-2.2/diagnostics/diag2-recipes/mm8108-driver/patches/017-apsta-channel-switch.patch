+struct ieee80211_vif *morse_get_active_ap(struct morse *mors)
+{
+	int vif_id = 0;
+	struct ieee80211_vif *vif = NULL;
+
+	spin_lock_bh(&mors->vif_list_lock);
+	for (vif_id = 0; vif_id < mors->max_vifs; vif_id++) {
+		vif = __morse_get_vif_from_vif_id(mors, vif_id);
+		if (vif && vif->type == NL80211_IFTYPE_AP && vif->bss_conf.enable_beacon)
+			break;
+
+		vif = NULL;
+	}
+	spin_unlock_bh(&mors->vif_list_lock);
+	return vif;
+}
