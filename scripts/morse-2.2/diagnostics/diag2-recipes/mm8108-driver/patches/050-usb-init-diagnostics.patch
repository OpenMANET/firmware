 	if (ret < 0) {
 		MORSE_USB_ERR(mors, "%s: wait_event_interruptible: error %d\n", __func__, ret);
 		goto error;
 	} else if (ret == 0) {
+		diag_timed_out = true;
 		/* Timed out. */
 		usb_kill_urb(musb->endpoints[MORSE_EP_MEM_RD].urb);
 	}
