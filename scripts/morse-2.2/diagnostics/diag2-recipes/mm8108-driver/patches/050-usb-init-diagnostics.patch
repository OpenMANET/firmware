--- a/usb.c
+++ b/usb.c
@@ -326,11 +326,23 @@
 		goto error;
 	}
 
+	if (musb->errors)
+		dev_err(mors->dev, "MM22DIAG command callback error=%d ep=0x%02x actual=%u\n",
+			musb->errors, ep->addr, ep->urb->actual_length);
 	musb->ongoing_cmd = 0;
 
 	return writesize;
 
 error:
+	if (writesize == sizeof(struct morse_usb_command)) {
+		struct morse_usb_command diag_cmd;
+
+		memcpy(&diag_cmd, user_buffer, sizeof(diag_cmd));
+		dev_err(mors->dev,
+			"MM22DIAG command dir=%u addr=0x%08x len=%u ep=0x%02x ret=%d callback_error=%d\n",
+			le32_to_cpu(diag_cmd.dir), le32_to_cpu(diag_cmd.address),
+			le32_to_cpu(diag_cmd.length), ep->addr, retval, musb->errors);
+	}
 	musb->ongoing_cmd = 0;
 	return retval;
 }
@@ -394,6 +406,8 @@
 static int morse_usb_mem_read(struct morse_usb *musb, u32 address, u8 *data, ssize_t size)
 {
 	int ret;
+	bool diag_submitted = false;
+	bool diag_timed_out = false;
 	struct morse_usb_command cmd;
 	struct morse *mors = usb_get_intfdata(musb->interface);
 
@@ -435,12 +449,14 @@
 		goto error;
