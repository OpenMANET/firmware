diff --git a/hw.c b/hw.c
index 6b80f0a..248721b 100644
--- a/hw.c
+++ b/hw.c
@@ -43,6 +43,10 @@ module_param(reattach_hw, bool, 0644);
 MODULE_PARM_DESC(reattach_hw,
 	"Do not reset hardware state during module exit, attempt to reattach during module init");
 
+bool enable_4v3_fem __read_mostly;
+module_param(enable_4v3_fem, bool, 0644);
+MODULE_PARM_DESC(enable_4v3_fem, "Enables 4.3V FEM");
+
 static const struct morse_chip_series *chip_series[] = {
 	&mm61xx_chip_series,
 	&mm81xx_chip_series,
@@ -938,3 +942,45 @@ int morse_hw_coredump_if_stopped(struct morse *mors)
 
 	return ret;
 }
+
+int morse_4v3_fem_init(struct morse *mors)
+{
+	int ret;
+
+	if (!mors || !mors->cfg)
+		return -EINVAL;
+
+	// Do not error out on the optional 4.3V FEM GPIO
+	if (!gpio_is_valid(mors->cfg->gpios.fem_4v3))
+		return 0;
+
+	ret = devm_gpio_request_one(mors->dev, mors->cfg->gpios.fem_4v3,
+				    enable_4v3_fem ? GPIOF_OUT_INIT_HIGH : GPIOF_OUT_INIT_LOW,
+				    "morse-4v3-fem-ctrl");
+	if (ret < 0) {
+		MORSE_PR_ERR(FEATURE_ID_DEFAULT, "Failed to request 4v3 FEM GPIO (gpio=%d, ret=%d)\n",
+		             mors->cfg->gpios.fem_4v3, ret);
+		return ret;
+	}
+
+
+	MORSE_DBG(mors, "Initialized 4v3 FEM GPIO %d (value: %d)\n",
+          mors->cfg->gpios.fem_4v3, enable_4v3_fem);
+
+	return 0;
+}
+
+int morse_get_4v3_fem_state(struct morse *mors)
+{
+	if(gpio_is_valid(mors->cfg->gpios.fem_4v3))
+		return gpio_get_value(mors->cfg->gpios.fem_4v3);
+	return 0;
+}
+
+int morse_set_4v3_fem_state(struct morse *mors, int state)
+{
+	if(gpio_is_valid(mors->cfg->gpios.fem_4v3))
+		gpio_set_value(mors->cfg->gpios.fem_4v3, state);
+	return 0;
+}
+
