# # Camera setup for RPI only

# # ONVIF server
# # (this will pull in libcamera/mediamtx to provide the stream)
CONFIG_PACKAGE_camera-onvif-server=y

# # Video encode/decode (for h264 hardware encode via libcamera)
CONFIG_PACKAGE_kmod-video-core=y
CONFIG_PACKAGE_kmod-codec-bcm2835=y

# # Actual camera driver
CONFIG_PACKAGE_kmod-camera-bcm2835-unicam=y

# # Supported sensors
CONFIG_PACKAGE_kmod-video-ov5647=y
CONFIG_PACKAGE_kmod-video-imx477=y
CONFIG_PACKAGE_kmod-video-imx219=y
CONFIG_PACKAGE_kmod-video-imx708=y

# # Utils
CONFIG_PACKAGE_v4l-utils=y
CONFIG_PACKAGE_libcamera-utils=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_libcamera=y
CONFIG_PACKAGE_mediamtx=y
CONFIG_PACKAGE_kmod-vchiq-mmal-bcm2835=y
CONFIG_PACKAGE_kmod-i2c-mux-pinctrl=y
CONFIG_PACKAGE_kmod-regmap-i2c=y
CONFIG_PACKAGE_kmod-video-dma-contig=y
CONFIG_PACKAGE_kmod-video-fwnode=y

# # Generic UVC cameras
# # Note that currently the ONVIF server doesn't know how to
# # advertise/configure these streams.
CONFIG_PACKAGE_kmod-video-uvc=y
