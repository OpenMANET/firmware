CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2711=y
CONFIG_TARGET_DEVICE_bcm27xx_bcm2711_DEVICE_bcm2711_raven=y

CONFIG_VERSION_MANUFACTURER="Raspberry Pi"
CONFIG_VERSION_PRODUCT="RAVEN"
CONFIG_VERSION_HWREV="1.0"

CONFIG_PACKAGE_bsp-raven=y
CONFIG_PACKAGE_kmod-mm8108=y
CONFIG_PACKAGE_mm8108-firmware=y

CONFIG_PACKAGE_kmod-mm6108=n
CONFIG_PACKAGE_mm6108-firmware=n
# Keep the old unified Gateworks driver off: it ships its own dot11ah.ko
# and clashes with kmod-dot11ah (see boards/venice/target_diffconfig).
CONFIG_PACKAGE_kmod-morse=n

CONFIG_TARGET_ROOTFS_PARTSIZE=4092
CONFIG_PACKAGE_persistent-vars-storage-bcm2711=y

# Video encode/decode
CONFIG_PACKAGE_kmod-video-core=y
CONFIG_PACKAGE_kmod-codec-bcm2835=y

# Enabling CONFIG_ALL_KMODS triggered a package installation
# bug with lan78xx - enabled by default for rpi4 platforms.
# We enable of-mdio to work around the dependency chain.
CONFIG_PACKAGE_kmod-of-mdio=y
# Disable ext4 image creation.
CONFIG_TARGET_ROOTFS_EXT4FS=n


# Some boards have no usb host capability.
# USB device support
CONFIG_PACKAGE_kmod-video-uvc=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_usb-modeswitch=y

#i2c
CONFIG_PACKAGE_i2c-tools=y

# Performance evaluation
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-conntrack=y
CONFIG_PACKAGE_collectd-mod-ipstatistics=y
CONFIG_PACKAGE_collectd-mod-ping=y
CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_arp-scan-database=y
CONFIG_IPERF_ENABLE_MULTICAST=y
CONFIG_PACKAGE_iperf3=n
CONFIG_PACKAGE_iperf=y
CONFIG_PACKAGE_iptraf-ng=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_fping=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_pciids=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_usbutils=y

# General usefulness
CONFIG_PACKAGE_luci-app-ttyd=y
# CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_picocom=y
CONFIG_PACKAGE_nano-full=y

# LuCI packages
CONFIG_PACKAGE_luci-app-morseupgrade=n