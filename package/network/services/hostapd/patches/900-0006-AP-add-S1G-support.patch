+	else
+		params->head = (u8 *) head;
+	#else
 	params->head = (u8 *) head;
+	#endif /* CONFIG_IEEE80211AH */
 	params->head_len = head_len;
 	params->tail = tail;
 	params->tail_len = tail_len;
