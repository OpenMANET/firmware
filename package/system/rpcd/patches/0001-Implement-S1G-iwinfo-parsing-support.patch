From: Lachlan Hodges <lachlan.hodges@morsemicro.com>
Date: Fri, 21 Feb 2025 13:44:47 +1100
Subject: [PATCH] Implement S1G iwinfo parsing support

---
 iwinfo.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/iwinfo.c b/iwinfo.c
index 2f02ecb..9b880f8 100644
--- a/iwinfo.c
+++ b/iwinfo.c
@@ -270,6 +270,11 @@ static void rpc_iwinfo_call_hw_ht_mode(int hwmodelist)
 	{
 		blobmsg_add_string(&buf, "hwmode", "ad");
 		return;
+	} 
+	else if (hwmodelist == IWINFO_80211_AH)
+	{
+		blobmsg_add_string(&buf, "hwmode", "ah");
+		return;
 	}
 
 	if (iw->htmode(ifname, &htmode))
