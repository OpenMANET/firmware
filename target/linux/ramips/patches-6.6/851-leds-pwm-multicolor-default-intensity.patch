From: Chris-Kleiner <224064191+Chris-Kleiner@users.noreply.github.com>
Subject: [PATCH] leds: pwm-multicolor: support default-mc-intensity and default-brightness

Allow a multi-led node to declare boot-time channel intensities and an
initial brightness:

    default-mc-intensity = <0 255 0>;
    default-brightness = <255>;

Without this, mc_subled intensities are zero-initialized, so a
multicolor LED driven only through its brightness attribute (e.g. by
/etc/diag.sh or a DT default trigger) stays dark until userspace
writes multi_intensity. Used by mt7621_morse_halowlink2.dts for the
boot status LED.
---
 drivers/leds/rgb/leds-pwm-multicolor.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

--- a/drivers/leds/rgb/leds-pwm-multicolor.c
+++ b/drivers/leds/rgb/leds-pwm-multicolor.c
@@ -108,6 +108,9 @@
 	struct pwm_mc_led *priv;
 	int count = 0;
 	int ret = 0;
+	u32 *intensities;
+	u32 brightness;
+	int i;
 
 	mcnode = device_get_named_child_node(&pdev->dev, "multi-led");
 	if (!mcnode)
@@ -147,6 +150,23 @@
 	if (ret)
 		goto release_mcnode;
 
+	intensities = devm_kcalloc(&pdev->dev, count, sizeof(*intensities),
+				   GFP_KERNEL);
+	if (!intensities) {
+		ret = -ENOMEM;
+		goto release_mcnode;
+	}
+
+	if (!fwnode_property_read_u32_array(mcnode, "default-mc-intensity",
+					    intensities,
+					    priv->mc_cdev.num_colors)) {
+		for (i = 0; i < priv->mc_cdev.num_colors; i++)
+			subled[i].intensity = intensities[i];
+	}
+
+	if (!fwnode_property_read_u32(mcnode, "default-brightness", &brightness))
+		cdev->brightness = min_t(u32, brightness, cdev->max_brightness);
+
 	init_data.fwnode = mcnode;
 	ret = devm_led_classdev_multicolor_register_ext(&pdev->dev,
 							&priv->mc_cdev,
