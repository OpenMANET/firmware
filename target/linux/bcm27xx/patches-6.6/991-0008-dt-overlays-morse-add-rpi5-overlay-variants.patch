diff --git a/arch/arm/boot/dts/overlays/mm_wlan-pi5-overlay.dts b/arch/arm/boot/dts/overlays/mm_wlan-pi5-overlay.dts
new file mode 100644
index 0000000..c60135a
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/mm_wlan-pi5-overlay.dts
@@ -0,0 +1,46 @@
+/dts-v1/;
+/plugin/;
+
+/ {
+	compatible = "brcm,bcm2712";
+
+	fragment@0 {
+		target = <&rp1_mmc0>;
+		wifi_ovl: __overlay__ {
+			pinctrl-0 = <&rp1_sdio0_22_27 &mm_sdio_pins_rp1>;
+			pinctrl-names = "default";
+			non-removable;
+			bus-width = <4>;
+			status = "okay";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			mm6108_sdio: mm6108_sdio@0 {
+				compatible = "morse,mm610x";
+				reset-gpios = <&gpio 17 0>;
+				power-gpios = <&gpio 3 0>,
+				              <&gpio 7 0>;
+				status = "okay";
+				reg = <2>;
+				bus-width = <4>;
+			};
+		};
+	};
+
+	fragment@1 {
+		target = <&rp1_sdio_clk0>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@2 {
+		target = <&rp1_gpio>;
+		__overlay__ {
+			mm_sdio_pins_rp1: mm_sdio_pins {
+				pins = "gpio1";
+				function = "gpio";
+				bias-pull-up;
+			};
+		};
+	};
+};
