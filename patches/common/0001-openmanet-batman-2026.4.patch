diff --git a/routing/batman-adv/patches/0002-keep-module-version.patch b/routing/batman-adv/patches/0002-keep-module-version.patch
new file mode 100644
index 0000000..66237dc
--- /dev/null
+++ b/routing/batman-adv/patches/0002-keep-module-version.patch
@@ -0,0 +1,14 @@
+batman-adv: retain the version on OpenWrt with stripped modules
+
+batctl -v reads the loaded module's version from sysfs. OpenWrt's
+CONFIG_MODULE_STRIPPED drops MODULE_VERSION. Keep this one metadata field
+so the upgraded package reports its version just like the previous one.
+
+--- a/net/batman-adv/version.c
++++ b/net/batman-adv/version.c
+@@ -25,4 +25,4 @@ struct new_utsname batadv_version_name =
+  * interface. It should be kept until it is unlikely that there are active
+  * installations of these "broken" versions of these tools with recent kernels.
+  */
+-MODULE_VERSION(UTS_RELEASE);
++MODULE_INFO(version, UTS_RELEASE);
