--- a/feeds/packages/utils/collectd/Makefile
+++ b/feeds/packages/utils/collectd/Makefile
@@ -9,7 +9,7 @@
 
 PKG_NAME:=collectd
 PKG_VERSION:=5.12.0
-PKG_RELEASE:=55
+PKG_RELEASE:=56
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.bz2
 PKG_SOURCE_URL:=https://collectd.org/files/ \
--- a/feeds/packages/utils/collectd/files/collectd.init
+++ b/feeds/packages/utils/collectd/files/collectd.init
@@ -589,7 +589,17 @@
 }
 
 start_service() {
+	# luci_statistics also starts us at boot. Never remove the configuration
+	# underneath an instance that procd has already launched.
+	local final_config="$COLLECTD_CONF" generated_config
+	generated_config=$(mktemp "${COLLECTD_CONF}.XXXXXX") || return 1
+	COLLECTD_CONF="$generated_config"
 	process_config
+	COLLECTD_CONF="$final_config"
+	if [ ! -s "$generated_config" ] || ! mv -f "$generated_config" "$final_config"; then
+		rm -f "$generated_config"
+		return 1
+	fi
 
 	procd_open_instance
 	procd_set_param command /usr/sbin/collectd
