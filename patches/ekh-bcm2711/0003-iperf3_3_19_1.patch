From abd147cf11c2a69381d94e5fda2fecdb8ce1023c Mon Sep 17 00:00:00 2001
From: Lyall Beveridge <lyall.beveridge@morsemicro.com>
Date: Fri, 26 Sep 2025 16:04:24 +1000
Subject: [PATCH] iperf3: update to 3.19.1 (sync with 806ee4b49)

This commit deletes the iPerf3 patches directory
and cherry picks: https://github.com/openwrt/packages/commit/806ee4b4919897a2b1adb1e8aed9bf4d1c25c3e4

Update to latest upstream release.

Changelog: https://github.com/esnet/iperf/releases/tag/3.19.1

Relevant security fixes: E-2025-54349, ESNET-SECADV-2025-0003, CVE-2025-54350,
ESNET-SECADV-2025-0002, VE-2025-54351, ESNET-SECADV-2025-0001

Build system: x86/64
Build-tested: x86/64-glibc
Run-tested: x86/64-glibc

Signed-off-by: Lyall Beveridge <lyall.beveridge@morsemicro.com>
---
 net/iperf3/Makefile                     |  6 +++---
 net/iperf3/patches/010-y2k.patch        | 21 ---------------------
 net/iperf3/patches/020-big-endian.patch | 21 ---------------------
 net/iperf3/patches/030-musl-crash.patch | 19 -------------------
 4 files changed, 3 insertions(+), 64 deletions(-)
 delete mode 100644 net/iperf3/patches/010-y2k.patch
 delete mode 100644 net/iperf3/patches/020-big-endian.patch
 delete mode 100644 net/iperf3/patches/030-musl-crash.patch

diff --git a/feeds/packages/net/iperf3/Makefile b/feeds/packages/net/iperf3/Makefile
index 45d4721bf..c99b8c577 100644
--- a/feeds/packages/net/iperf3/Makefile
+++ b/feeds/packages/net/iperf3/Makefile
@@ -8,12 +8,12 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=iperf
-PKG_VERSION:=3.17.1
-PKG_RELEASE:=4
+PKG_VERSION:=3.19.1
+PKG_RELEASE:=1
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
